#!/usr/bin/env php
<?php

include $_composer_autoload_path ?? __DIR__.'/../vendor/autoload.php';

use LukeDavis\GcpApiGatewaySpec\Commands\Generate;
use Symfony\Component\Console\Application;

$application = new Application();
$application->setName('gcp-api-gateway-spec');
$application->setVersion('2.0.4');

// Application::addCommand() was added in symfony/console 7.4; add() was
// deprecated there and removed in symfony/console 8
if (method_exists($application, 'addCommand')) {
    $application->addCommand(new Generate());
} else {
    $application->add(new Generate());
}

$application->run();
